trigger ClaimEventTrigger on Claim_Event__c (before insert, before update, before delete) {
    if (Trigger.isInsert && ClaimGuardAudit.isWriting()) {
        return;
    }
    List<Claim_Event__c> records = Trigger.isDelete ? Trigger.old : Trigger.new;
    for (Claim_Event__c event : records) {
        event.addError('Audit events are generated by ClaimGuard and cannot be edited or deleted.');
    }
}
